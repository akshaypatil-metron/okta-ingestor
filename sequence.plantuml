@startuml sequence
' =======================
' Pastel Blue Theme Styling
' =======================
skinparam backgroundColor #e6f0fa
skinparam sequence {
    ArrowColor #5a7ea8
    LifeLineBorderColor #5a7ea8
    LifeLineBackgroundColor #cfe0f5
    ParticipantBorderColor #5a7ea8
    ParticipantBackgroundColor #cfe0f5
    ParticipantFontColor #2c3e50
    ActorFontColor #2c3e50
}
skinparam note {
    BackgroundColor #cfe0f5
    BorderColor #5a7ea8
    FontColor #2c3e50
}
skinparam defaultFontColor #2c3e50

title Okta System Logs Ingestion Flow

actor User
participant "Main (main.go)" as Main
participant "Health Server" as Health
participant "Scheduler" as Scheduler
participant "Okta Client" as Okta
database "MongoDB" as Mongo
participant "Webhook Sender" as Webhook

' =======================
' Application Startup
' =======================
User -> Main : Run Application
activate Main

Main -> Main : Load Config (env / yaml)
note right of Main
Reads:
- OKTA_DOMAIN
- OKTA_TOKEN
- MONGO_URI
- WEBHOOK_URL
- POLL_INTERVAL
end note

Main -> Main : Initialize Logger
Main -> Main : Create Root Context

Main -> Health : Start /health endpoint
activate Health
Health --> Main : Health server running
deactivate Health

Main -> Mongo : Connect to MongoDB
activate Mongo
Mongo --> Main : Connection established
deactivate Mongo

Main -> Main : Init Okta Client
Main -> Main : Init Mongo Repository
Main -> Main : Init Webhook Sender

Main -> Scheduler : Start Polling Loop (goroutine)
activate Scheduler

Main --> User : Application Running

' =======================
' Scheduler Loop
' =======================
loop Every Poll Interval
    Scheduler -> Scheduler : Wait for ticker.C

    Scheduler -> Okta : FetchLogs(since, ASCENDING)
    activate Okta

    loop Pagination
        Okta -> Okta : HTTP GET /api/v1/logs
        note right of Okta
        Query:
        since
        limit
        sortOrder=ASCENDING
        end note

        alt Rate Limited (429)
            Okta -> Okta : Sleep / Retry
        else Success (200)
            Okta -> Okta : Decode JSON events
            Okta -> Okta : Track maxPublished
        end

        alt Link rel="next" exists
            Okta -> Okta : Follow next page
        else No more pages
            break
        end
    end

    Okta --> Scheduler : events[], maxPublished
    deactivate Okta

    Scheduler -> Scheduler : Deduplicate(events)
    note right of Scheduler
    In-memory UUID map
    Removes duplicates within batch
    end note

    Scheduler -> Mongo : InsertMany(events)
    activate Mongo
    alt Duplicate UUID
        Mongo --> Scheduler : Ignore duplicate key error
    else Insert Success
        Mongo --> Scheduler : OK
    end
    deactivate Mongo

    Scheduler -> Webhook : Send(events)
    activate Webhook
    alt Webhook Failure
        Webhook -> Webhook : Retry N times
        Webhook --> Scheduler : Continue (safe)
    else 200 OK
        Webhook --> Scheduler : Delivered
    end
    deactivate Webhook

    Scheduler -> Mongo : SaveState(maxPublished)
    activate Mongo
    Mongo --> Scheduler : Cursor Updated
    deactivate Mongo

    Scheduler -> Scheduler : Update since = maxPublished
end

' =======================
' Graceful Shutdown
' =======================
User -> Main : SIGINT / SIGTERM
Main -> Main : cancel()

Main -> Scheduler : Context Cancelled
activate Scheduler
Scheduler -> Scheduler : Exit loop
Scheduler --> Main : Stopped
deactivate Scheduler

Main -> Mongo : Close connection
activate Mongo
Mongo --> Main : Closed
deactivate Mongo

Main --> User : Shutdown Complete
deactivate Main

@enduml